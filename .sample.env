NODE_ENV=dev
PORT=5001

POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_DB=voc_panel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
TYPEORM_SYNCHRONIZE=true

REDIS_HOST=localhost
REDIS_PORT=6382
REDIS_PASSWORD=redis

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5675
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_MANAGEMENT_PORT=15675

JWT_SECRET=replace-with-a-long-random-access-token-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-token-secret

SUPERSET_URL=http://localhost:8088
SUPERSET_USERNAME=admin
SUPERSET_PASSWORD=admin
SUPERSET_PROVIDER=db

CRM_FETCH_URL=https://crm.dayins.com/panel/rest/voc_fetch_all/
CRM_SOURCE=smart
CRM_FETCH_LIMIT=1000
CRM_SYNC_ENABLED=true
CRM_INITIAL_LAST_MODIFIED=2025-07-19 16:49:47
